cabal-version:      2.4
name:               haskell-book
version:            0.1.0.0
synopsis:           Code harness for the Haskell book draft
description:        Scaffold P0: builds the sample modules extracted from
                    Haskell.md and runs their regression specs.
license:            BSD-3-Clause
author:             will
maintainer:         will
build-type:         Simple

library
    hs-source-dirs:   src
    exposed-modules:  Ch01.Basics
                      Ch01.Tour
                      Ch02.Functions
                      Ch03.ADT
                      Ch04.TypeClass
                      Ch05.Category
                      Ch06.Hask
                      Ch07.Functor
                      Ch08.Applicative
    build-depends:    base        >=4.16 && <5
                    , containers  >=0.6
                    , text        >=2.0
                    , mtl         >=2.2
    default-language: GHC2021
    ghc-options:      -Wall

executable hello
    hs-source-dirs:   src
    main-is:          Ch01/Hello.hs
    build-depends:    base
    default-language: GHC2021
    ghc-options:      -Wall

test-suite spec
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          Spec.hs
    build-depends:    base
                    , containers
                    , text
                    , haskell-book
                    , hspec       >=2.10
    default-language: GHC2021
    ghc-options:      -Wall
